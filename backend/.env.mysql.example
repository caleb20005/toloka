# Hostnali / cPanel MySQL or MariaDB production configuration.
DB_CLIENT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=replace_with_cpanel_database_name
MYSQL_USER=replace_with_cpanel_database_user
MYSQL_PASSWORD=replace_with_strong_database_password
MYSQL_POOL_MAX=20
MYSQL_QUEUE_LIMIT=0
MYSQL_KEEPALIVE_DELAY_MS=10000
MYSQL_SSL=false

NODE_ENV=production
PORT=5500
TRUST_PROXY=true
AUTH_SECRET=replace-with-a-long-random-secret
# Comma-separated phone numbers of the only accounts that may operate the
# hosted Control Tower. Local access continues to work without this setting.
CONTROL_TOWER_ADMIN_PHONES=0180527038
# Set these only in the hosting environment while seeding. Remove the password
# variable immediately after `npm run seed:control-tower` succeeds.
CONTROL_TOWER_BOOTSTRAP_PHONE=0180527038
CONTROL_TOWER_BOOTSTRAP_PASSWORD=
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000

# Enable only after the SMS Forwarder webhook has been configured and tested over HTTPS.
SMS_FORWARDER_ENABLED=true
# A long, random secret shared only with the app's webhook URL or Authorization header.
SMS_FORWARDER_WEBHOOK_TOKEN=
# Optional hardening for matching message pairs.
MPESA_MAX_MESSAGE_AGE_MS=86400000
MPESA_MESSAGE_TIME_TOLERANCE_MS=120000
MPESA_MESSAGE_SIMILARITY=0.9

# Used only by the one-time copy script; never place a production secret in git.
# SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/toloka
# SOURCE_PGSSL=true
# MIGRATION_CHUNK_SIZE=250
