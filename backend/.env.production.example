# MySQL/MariaDB: Hostnali cPanel production configuration.
DB_CLIENT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=replace_with_cpanel_database_name
MYSQL_USER=replace_with_cpanel_database_user
MYSQL_PASSWORD=replace_with_strong_database_password
MYSQL_POOL_MAX=20
MYSQL_QUEUE_LIMIT=0
MYSQL_KEEPALIVE_DELAY_MS=10000
MYSQL_SSL=false

# Required in production. Generate a long random value and keep it secret.
AUTH_SECRET=replace-with-a-long-random-secret
CONTROL_TOWER_ADMIN_PHONES=+254700000000
NODE_ENV=production
TRUST_PROXY=true

# SMS Forwarder remains off until the phone and public HTTPS callback are configured.
SMS_FORWARDER_ENABLED=false
SMS_FORWARDER_WEBHOOK_TOKEN=

# Keep the existing PostgreSQL dump until the MySQL database has been verified
# against live accounts, payments, task unlocks, and referral rewards.
